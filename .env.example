# Copy to .env and change the passwords. .env is git-ignored.

# Local staging database (docker compose only)
POSTGRES_ADMIN_PASSWORD=change-me-admin
EEG20_DB_PASSWORD=change-me-writer
EEG20_DB_PORT=55432

# Screening settings
# NRW (default), DE for all of Germany, or a state code such as BY or NI
EEG20_SCOPE=NRW
EEG20_REFERENCE_DATE=2026-01-01
EEG20_HORIZON_YEARS=5
EEG20_TARGET_SCHEMA=iris_staging

# For running outside docker
# DATABASE_URL=postgresql://eeg20_writer:change-me-writer@127.0.0.1:55432/iris_staging_db
# EEG20_SOURCE_DIR=fixtures/mastr
# EEG20_OUTPUT_DIR=output
